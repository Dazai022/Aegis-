# =========================
# Aegis - Environment Example
# Copy to .env and fill in values. NO REAL SECRETS HERE.
# =========================

# ---- PostgreSQL ----
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__
POSTGRES_DB=aegis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis_admin:__REPLACE_WITH_STRONG_PASSWORD__@postgres:5432/aegis

# ---- Backend JWT ----
JWT_SECRET=__REPLACE_WITH_32_BYTE_CSPRNG_BASE64__
JWT_ALG=HS256
JWT_EXPIRE_MIN=15

# ---- Pepper for API-Key HMAC-SHA256 ----
PEPPER=__REPLACE_WITH_32_BYTE_CSPRNG_HEX__

# ---- AES-256-GCM Master Key (32 bytes, base64) ----
AES_MASTER_KEY_BASE64=__REPLACE_WITH_AES_256_KEY_BASE64__

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Rate Limits ----
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_PER_IP_PER_MIN=60

# ---- Approval Expiry (seconds) ----
APPROVAL_EXPIRE_SECONDS=600

# ---- Risk Thresholds ----
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
RISK_CRITICAL_MIN=80

# ---- Max request bytes ----
MAX_REQUEST_BYTES=1048576
MAX_OUTPUT_BYTES=65536

# ---- Terminal Sandbox (seconds / MB / CPUs) ----
TERMINAL_TIMEOUT_SECONDS=30
TERMINAL_MEMORY_MB=256
TERMINAL_CPU_SHARES=0.5
TERMINAL_IMAGE=aegis-terminal-sandbox:latest

# ---- App ----
ENV=dev
APP_NAME=aegis
APP_VERSION=0.1.0

# ---- Admin bootstrap (optional, for `python -m app.scripts.create_admin --from-env`) ----
AEGIS_ADMIN_EMAIL=admin@aegis.local
AEGIS_ADMIN_PASSWORD=__REPLACE_WITH_ADMIN_PASSWORD__

# ---- Optional GitHub test token (NOT stored in DB; used only for integration test manual runs) ----
GITHUB_TEST_TOKEN=__OPTIONAL_REPLACE_WITH_READ_ONLY_PAT_FOR_MANUAL_TESTS__
